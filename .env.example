# Copy to .env for local uvicorn / Streamlit. Docker Compose reads these
# names from the shell or from a .env file next to docker-compose.yml.

# Offline mode is the default. Set LLM_ENABLED=true and a key to call a model.
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
USE_OPENAI_EMBEDDINGS=false

# Create a cosine index whose dimension matches the embedder
# (256 for the built-in hashing embedder, 1536 for text-embedding-3-small).
PINECONE_API_KEY=
PINECONE_INDEX=harborline-assistant

# LangSmith. Tracing stays off until both values below are set.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=harborline-assistant

# MCP server started by docker-compose, or run it yourself on port 8100.
MCP_URL=http://127.0.0.1:8100/mcp
MCP_FALLBACK=true

# Token bucket. A chat costs one token.
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_MINUTE=6

# Pin the clock when you want the sample corpus window to be deterministic.
APP_TODAY=2026-11-06

API_BASE_URL=http://127.0.0.1:8000
SESSION_SECRET=change-me-before-any-shared-demo
